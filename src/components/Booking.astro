---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { photos } from '../config/photos';
import Icon from './Icon.astro';
---

<section class="section section--alt booking" id="booking" aria-labelledby="booking-title">
  <div class="container booking__grid">
    <div class="booking__intro reveal">
      <h2 id="booking-title" class="h2" data-i18n="booking.title">Есть проблема с автомобилем?</h2>
      <p class="lead" data-i18n="booking.lead">Оставьте заявку, и наш специалист свяжется с вами для уточнения деталей.</p>

      <div class="booking__direct">
        <a class="booking__call" href={`tel:${site.phone.href}`}>
          <span class="booking__call-ic"><Icon name="phone-call" size={22} /></span>
          <span>
            <span class="booking__call-label" data-i18n="booking.call">Или позвоните сейчас</span>
            <span class="booking__call-num">{site.phone.display}</span>
          </span>
        </a>
        <p class="booking__hours" data-i18n="site.hours">{site.hours}</p>
      </div>

      <figure class="booking__photo">
        <Image
          src={photos.obd.src}
          alt={photos.obd.alt}
          data-i18n-attr="alt:gal.alt.obd"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          format="webp"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="bcard reveal" style="--d:120ms">
      <form
        class="bform"
        data-lead-form
        data-endpoint={site.endpoints.lead}
        data-email={site.email}
        data-phone={site.phone.display}
        data-phone-href={site.phone.href}
        novalidate
      >
        <div class="field">
          <label class="field__label" for="b-name"><span data-i18n="f.name">Ваше имя</span> <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="b-name" name="name" type="text" autocomplete="name" required aria-describedby="b-name-err" placeholder="Как к вам обращаться" data-i18n-attr="placeholder:f.ph.name" />
          <p class="field__error" id="b-name-err"></p>
        </div>

        <div class="field">
          <label class="field__label" for="b-phone"><span data-i18n="f.phone">Номер телефона</span> <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="b-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="b-phone-err" placeholder="+7 (000) 000-00-00" />
          <p class="field__error" id="b-phone-err"></p>
        </div>

        <div class="field">
          <label class="field__label" for="b-car" data-i18n="f.car">Марка и модель автомобиля</label>
          <input class="input" id="b-car" name="car" type="text" autocomplete="off" placeholder="Например, Toyota Camry, 2015" data-i18n-attr="placeholder:f.ph.car" />
        </div>

        <div class="field">
          <label class="field__label" for="b-message" data-i18n="f.message">Опишите проблему или необходимую услугу</label>
          <textarea class="input" id="b-message" name="message" rows="4" placeholder="Например: стук в подвеске при торможении" data-i18n-attr="placeholder:f.ph.message"></textarea>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label class="consent" for="b-consent">
            <input id="b-consent" name="consent" type="checkbox" required aria-describedby="b-consent-err" />
            <span><span data-i18n="f.consent.a">Согласен на обработку персональных данных в соответствии с</span> <a href="/privacy" target="_blank" rel="noopener" data-i18n="f.consent.link">политикой конфиденциальности</a></span>
          </label>
          <p class="field__error" id="b-consent-err"></p>
        </div>

        <button class="btn btn--primary bform__submit" type="submit">
          <span class="bform__submit-text" data-i18n="f.submit">ОТПРАВИТЬ ЗАЯВКУ</span>
          <Icon name="arrow-right" size={18} class="btn__arrow" />
        </button>

        <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
      </form>
    </div>
  </div>
</section>

<style>
  .booking__grid {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .booking__intro {
    display: grid;
    gap: 26px;
    align-content: start;
  }
  .booking__direct {
    display: grid;
    gap: 8px;
  }
  .booking__call {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    width: fit-content;
    text-decoration: none;
  }
  .booking__call-ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 107, 53, 0.55);
    color: var(--accent);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .booking__call:hover .booking__call-ic {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .booking__call-label {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .booking__call-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
  }
  .booking__hours {
    color: var(--muted);
    font-size: 0.875rem;
    padding-left: 68px;
  }
  .booking__photo {
    display: none;
    border-radius: var(--radius-l);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .booking__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
    filter: saturate(0.9);
  }

  .bcard {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: clamp(22px, 3.4vw, 44px);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.6);
  }
  .bform {
    display: grid;
    gap: 20px;
  }
  .bform__submit {
    width: 100%;
    min-height: 58px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  @media (min-width: 1024px) {
    .booking__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .booking__photo {
      display: block;
      margin-top: 12px;
    }
    .bcard {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>

<script>
  import { initLeadForm } from '../scripts/lead-form';
  initLeadForm();
</script>
