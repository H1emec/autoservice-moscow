---
import { Picture } from 'astro:assets';
import { hero } from '../config/hero';
import { photos } from '../config/photos';
import Icon from './Icon.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={photos.hero.src}
      alt=""
      widths={[900, 1400, 1800]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__body">
    <h1 id="hero-title" class="hero__title">
      {hero.titleLines.map((line, i) => (
        <span class="hero__line"><span class:list={['hero__line-in', { 'is-accent': i === hero.accentLine }]} style={`--i:${i}`} data-i18n={`hero.l.${i}`}>{line}</span></span>
      ))}
    </h1>

    <div class="hero__sub">
      <p class="hero__lead" data-i18n="hero.subtitle">{hero.subtitle}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#booking"><span data-i18n="hero.cta1">{hero.primaryCta}</span> <Icon name="arrow-right" size={18} class="btn__arrow" /></a>
        <a class="btn btn--ghost" href="#services" data-i18n="hero.cta2">{hero.secondaryCta}</a>
      </div>
    </div>

    <ul class="hero__adv" role="list">
      {hero.advantages.map((a, i) => (
        <li><Icon name={a.icon} size={22} /><span data-i18n={`hero.adv.${i}`}>{a.text}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    min-height: max(620px, 100svh);
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-h) + 24px);
    overflow: clip;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
    transform: scale(1.06);
    animation: hero-settle 2.2s var(--ease) 0.1s forwards;
  }
  /* Скрим: слева и снизу, чтобы текст читался, а машина оставалась в свету */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(17, 18, 20, 0.86) 0%, rgba(17, 18, 20, 0.5) 42%, rgba(17, 18, 20, 0.12) 78%),
      linear-gradient(0deg, var(--bg) 0%, rgba(17, 18, 20, 0.7) 22%, rgba(17, 18, 20, 0) 55%),
      linear-gradient(180deg, rgba(17, 18, 20, 0.62) 0%, rgba(17, 18, 20, 0) 22%);
  }

  .hero__body {
    padding-bottom: clamp(28px, 4vw, 48px);
    display: grid;
    gap: clamp(24px, 3.2vw, 44px);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    /* Самое длинное слово «АВТОСЕРВИС» ≈ 9.5em: на 320px кегль до 30px (≈9vw) */
    font-size: clamp(1.5rem, 4.6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .hero__line-in {
    display: block;
    transform: translateY(105%);
    animation: line-up 1.1s var(--ease) calc(0.25s + var(--i) * 0.12s) forwards;
  }
  .hero__line-in.is-accent {
    color: var(--accent);
  }

  .hero__sub {
    display: grid;
    gap: 28px;
    max-width: 640px;
    opacity: 0;
    transform: translateY(16px);
    animation: fade-up 1s var(--ease) 0.85s forwards;
  }
  .hero__lead {
    color: #d3d5d9;
    font-size: clamp(1rem, 1.35vw, 1.1875rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__adv {
    margin: clamp(8px, 2vw, 20px) 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line-strong);
    display: grid;
    gap: 16px 40px;
    grid-template-columns: minmax(0, 1fr);
    opacity: 0;
    animation: fade-up 1s var(--ease) 1.05s forwards;
  }
  .hero__adv li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9375rem;
    color: #e4e5e8;
  }
  .hero__adv svg {
    color: var(--accent);
    flex: none;
  }

  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @keyframes fade-up {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-settle {
    to {
      transform: scale(1);
    }
  }

  @media (min-width: 768px) {
    .hero__adv {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }
  }
  @media (max-width: 767px) {
    .hero__title {
      font-size: clamp(1.5rem, 8.6vw, 3.2rem);
    }
    .hero {
      padding-bottom: 72px; /* нижняя панель действий */
    }
    .hero__adv {
      gap: 12px;
    }
    .hero__cta .btn {
      flex: 1 1 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__line-in,
    .hero__sub,
    .hero__adv {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .hero__media :global(.hero__img) {
      animation: none;
      transform: none;
    }
  }
</style>
