---
import { Image, getImage } from 'astro:assets';
import { gallery, galleryIntro } from '../config/gallery';
import { photos } from '../config/photos';
import Icon from './Icon.astro';

const tiles = await Promise.all(
  gallery.map(async (g) => {
    const p = photos[g.photo];
    const full = await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp', quality: 70 });
    return { ...g, p, full: full.src };
  }),
);
---

<section class="section section--alt gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="gallery__head reveal">
      <h2 id="gallery-title" class="h2" data-i18n="gal.title">{galleryIntro.title}</h2>
      <p class="lead" data-i18n="gal.subtitle">{galleryIntro.subtitle}</p>
    </div>

    <ul class="gallery__grid" role="list">
      {tiles.map((t, i) => (
        <li class={`tile tile--${t.area} reveal`} style={`--d:${(i % 4) * 70}ms`}>
          <button class="tile__btn" type="button" data-lightbox-index={i} data-full={t.full}>
            <Image
              src={t.p.src}
              alt={t.p.alt}
              data-i18n-attr={`alt:gal.alt.${t.photo}`}
              widths={[360, 560, 840, 1200]}
              sizes="(min-width: 1024px) 45vw, 50vw"
              format="webp"
              quality={72}
              loading="lazy"
              style={`object-position:${t.focus ?? '50% 50%'}`}
            />
            <span class="tile__cap">
              <span data-i18n={`gal.cap.${t.photo}`}>{t.caption}</span>
              <span class="tile__ic"><Icon name="maximize-2" size={16} stroke={2} /></span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lb" data-lightbox aria-label="Просмотр фотографии" data-i18n-attr="aria-label:lb.label">
    <div class="lb__bar">
      <p class="lb__count" data-lb-count aria-live="polite"></p>
      <button class="lb__btn" type="button" data-lb-close aria-label="Закрыть" data-i18n-attr="aria-label:lb.close"><Icon name="x" size={22} stroke={2} /></button>
    </div>
    <div class="lb__stage">
      <button class="lb__btn lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Предыдущее фото" data-i18n-attr="aria-label:lb.prev"><Icon name="chevron-left" size={26} stroke={2} /></button>
      <figure class="lb__fig">
        <img class="lb__img" data-lb-img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
        <figcaption class="lb__cap" data-lb-cap></figcaption>
      </figure>
      <button class="lb__btn lb__nav lb__nav--next" type="button" data-lb-next aria-label="Следующее фото" data-i18n-attr="aria-label:lb.next"><Icon name="chevron-right" size={26} stroke={2} /></button>
    </div>
  </dialog>
</section>

<style>
  .gallery__head {
    display: grid;
    gap: 22px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  @media (min-width: 1024px) {
    .gallery__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 48px;
    }
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 150px;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .tile {
    min-width: 0;
    min-height: 0;
  }
  .tile--a { grid-column: 1 / 3; grid-row: span 2; }
  .tile--b { grid-row: span 2; }
  .tile--c { grid-row: span 2; }

  .tile__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    cursor: zoom-in;
  }
  .tile__btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease),
      filter 0.5s var(--ease);
    filter: saturate(0.92) brightness(0.94);
  }
  .tile__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 36px 14px 12px;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(0deg, rgba(17, 18, 20, 0.85), rgba(17, 18, 20, 0));
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .tile__ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .tile__cap > span:first-child {
    min-width: 0;
    text-wrap: balance;
  }
  @media (max-width: 639px) {
    .tile__ic {
      display: none;
    }
  }
  @media (hover: hover) {
    .tile__cap {
      opacity: 0;
      transform: translateY(8px);
    }
    .tile__btn:hover :global(img),
    .tile__btn:focus-visible :global(img) {
      transform: scale(1.05);
      filter: none;
    }
    .tile__btn:hover .tile__cap,
    .tile__btn:focus-visible .tile__cap {
      opacity: 1;
      transform: none;
    }
  }
  .tile__btn:focus-visible {
    outline-offset: -3px;
  }

  @media (min-width: 640px) {
    .gallery__grid {
      grid-auto-rows: 200px;
      gap: 16px;
    }
  }

  /* Асимметричная мозаика: 12 колонок, плитки разной высоты и ширины */
  @media (min-width: 1024px) {
    .gallery__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: clamp(84px, 9.2vw, 126px);
    }
    .tile--a { grid-column: 1 / 7;  grid-row: 1 / 4; }
    .tile--b { grid-column: 7 / 10; grid-row: 1 / 5; }
    .tile--c { grid-column: 10 / 13; grid-row: 1 / 4; }
    .tile--d { grid-column: 1 / 4;  grid-row: 4 / 7; }
    .tile--e { grid-column: 4 / 7;  grid-row: 4 / 7; }
    .tile--f { grid-column: 7 / 10; grid-row: 5 / 7; }
    .tile--g { grid-column: 10 / 13; grid-row: 4 / 7; }
  }

  /* Лайтбокс */
  .lb {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 11, 12, 0.96);
    color: #fff;
  }
  .lb[open] {
    display: grid;
    grid-template-rows: auto 1fr;
    animation: lb-in 0.35s var(--ease);
  }
  .lb::backdrop {
    background: rgba(10, 11, 12, 0.9);
  }
  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px var(--gutter);
  }
  .lb__count {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .lb__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .lb__btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .lb__stage {
    position: relative;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 0 clamp(8px, 7vw, 96px) 16px;
  }
  .lb__fig {
    display: grid;
    gap: 14px;
    justify-items: center;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    touch-action: pan-y;
  }
  .lb__img {
    max-width: 100%;
    max-height: calc(100dvh - 150px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lb__cap {
    color: #d3d5d9;
    font-size: 0.9375rem;
    text-align: center;
  }
  .lb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .lb__nav--prev { left: clamp(8px, 2vw, 28px); }
  .lb__nav--next { right: clamp(8px, 2vw, 28px); }
  @media (max-width: 639px) {
    .lb__nav {
      top: auto;
      bottom: 14px;
      transform: none;
    }
    .lb__nav--prev { left: 16px; }
    .lb__nav--next { right: 16px; }
    .lb__img { max-height: calc(100dvh - 190px); }
  }
  @keyframes lb-in {
    from { opacity: 0; }
  }
</style>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>
