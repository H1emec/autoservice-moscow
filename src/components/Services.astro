---
import { Image } from 'astro:assets';
import { services, servicesIntro } from '../config/services';
import { site } from '../config/site';
import Icon from './Icon.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/services/**/*.jpg', { eager: true });
const photoOf = (p: string) => photos[`../assets/services/${p}`].default;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="services__head reveal">
      <h2 id="services-title" class="h2" data-i18n="svc.title">{servicesIntro.title}</h2>
      <p class="services__hint">
        <span data-i18n="svc.hint">Не нашли свою неисправность?</span> <a href={`tel:${site.phone.href}`}>{site.phone.display}</a>
      </p>
    </div>

    <div data-svc-tabs>
      <div class="tabs" role="tablist" aria-label="Категории услуг">
        {services.map((c, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`svc-tab-${c.id}`}
            aria-controls={`svc-panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab__icon"><Icon name={c.icon} size={22} stroke={1.7} /></span>
            <span class="tab__name" data-i18n={`svc.${c.id}.name`}>{c.name}</span>
          </button>
        ))}
      </div>

      {services.map((c, i) => (
        <div class="panel" role="tabpanel" id={`svc-panel-${c.id}`} aria-labelledby={`svc-tab-${c.id}`} hidden={i !== 0}>
          <ul class="grid" role="list">
            {c.items.map((it, n) => (
              <li class="card">
                <div class="card__media">
                  <Image src={photoOf(it.photo)} alt={it.name} width={420} height={260} quality={70} format="webp" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" data-i18n-attr={`alt:svc.${c.id}.i.${n}`} />
                </div>
                <div class="card__body">
                  <h3 class="card__name" data-i18n={`svc.${c.id}.i.${n}`}>{it.name}</h3>
                  <a class="btn btn--primary btn--sm card__cta" href="#booking" data-prefill-service={it.name} data-prefill-key={`svc.${c.id}.i.${n}`}>
                    <span data-i18n="svc.cta">Записаться в автосервис</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(40px, 5vw, 72px);
  }
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(16px, 2vw, 24px);
  }
  .services__hint {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .services__hint a {
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }
  .services__hint a:hover {
    color: var(--accent);
  }

  /* Вкладки категорий: одна линия, текст переносится по словам */
  .tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
    gap: 8px;
    margin-bottom: clamp(14px, 1.6vw, 20px);
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    padding: 12px 8px;
    background: var(--card);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: #e4e5e8;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .tab:hover {
    background: var(--card-hover);
  }
  .tab__name {
    min-width: 0;
    text-wrap: balance;
  }
  .tab__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .tab[aria-selected='true'] {
    border-color: var(--accent);
    color: #fff;
  }
  .tab[aria-selected='true'] .tab__icon {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Услуги выбранной категории: всё помещается в один экран */
  .panel {
    animation: panel-in 0.4s var(--ease);
  }
  .grid {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--card);
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .card:hover {
    background: var(--card-hover);
    border-color: rgba(255, 107, 53, 0.45);
  }
  .card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
  }
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.04);
  }
  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 12px 12px 14px;
  }
  .card__name {
    flex: 1;
    font-family: var(--font-text);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .card__cta {
    align-self: stretch;
    justify-content: center;
    min-height: 40px;
    padding: 8px 10px;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
    white-space: normal;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 719px) {
    .tabs {
      grid-auto-columns: 112px;
      gap: 6px;
    }
    .tab {
      padding: 10px 6px;
      font-size: 0.8125rem;
    }
    .card__body {
      padding: 10px 10px 12px;
    }
    .card__name {
      font-size: 0.875rem;
    }
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .tabs {
      grid-auto-columns: minmax(0, 1fr);
      overflow: visible;
      padding-bottom: 0;
    }
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }
    .panel {
      min-height: 400px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
    .card__media :global(img),
    .card:hover .card__media :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { initServiceTabs } from '../scripts/service-tabs';
  initServiceTabs();
</script>
