---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../config/site';
import { photos } from '../config/photos';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ключи перевода заголовка и описания (src/i18n/dict.ts) */
  titleKey?: string;
  descKey?: string;
  noindex?: boolean;
  /** true на главной: в разметку добавляется JSON-LD организации */
  schema?: boolean;
}

const {
  title = site.title,
  description = site.description,
  titleKey = 'meta.title',
  descKey = 'meta.description',
  noindex = false,
  schema = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: photos.hero.src, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'center' });
const ogUrl = new URL(og.src, site.url).href;

// Пустые контакты в разметку не попадают
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: site.name,
  url: site.url,
  image: ogUrl,
  telephone: site.phone.href,
  ...(site.email ? { email: site.email } : {}),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: 'Москва',
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.map.lat, longitude: site.map.lon },
  ...(site.instagram.url ? { sameAs: [site.instagram.url] } : {}),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-attr={`content:${descKey}`} />
    <meta name="theme-color" content="#111214" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="skip">Перейти к содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import { initI18n } from '../scripts/i18n';
      initI18n();
    </script>
  </body>
</html>
